import Mathlib

set_option linter.style.header false

/-!
# St(4), St(5), St(6) の明示的閉形式定義

論文 `6_kanren.tex` の Section 4.4–4.6 で導出された、AR(4)/AR(5)/AR(6) の
定常性領域 St(p) の明示的閉形式条件をそのままLeanの定義として書き下したもの。

添字対応: `φ : Fin p → ℝ` に対し `φ 0 = φ_1, φ 1 = φ_2, …, φ (p-1) = φ_p`
(論文の1始まり添字を、Leanの0始まり `Fin p` にそのままシフトしただけ)。

ここでは**定義の書き下しのみ**を行う。これが元の定常性
(特性方程式の根がすべて単位円内にある)と同値であることの証明は
論文の主結果そのものであり、別途大きな作業として残っている
(このファイルの末尾に一般の `IsStationary` 述語だけ用意してある)。
-/

open Finset

namespace StTopology

/-- φ(1) = 1 - φ_1 - φ_2 - ⋯ - φ_p (特性多項式 φ(z) = 1 - ∑ φ_k z^k の z=1 での値) -/
def phiAt1 {p : ℕ} (φ : Fin p → ℝ) : ℝ := 1 - ∑ i : Fin p, φ i

/-- φ(-1) = 1 - ∑_k φ_k (-1)^k -/
def phiAtNeg1 {p : ℕ} (φ : Fin p → ℝ) : ℝ :=
  1 - ∑ i : Fin p, φ i * (-1 : ℝ) ^ ((i : ℕ) + 1)

/-- St(4) の明示的閉形式 (6_kanren.tex, Section 4.4, 式(122)–(124)相当):
`φ(1)>0, φ(-1)>0, (φ_3+φ_1φ_4)(φ_1-φ_3)+(1+φ_4)^2(1+φ_2-φ_4)>0, 2(1+φ_4)>|φ_1-φ_3|` -/
def St4 (φ : Fin 4 → ℝ) : Prop :=
  phiAt1 φ > 0 ∧ phiAtNeg1 φ > 0 ∧
  (φ 2 + φ 0 * φ 3) * (φ 0 - φ 2) + (1 + φ 3) ^ 2 * (1 + φ 1 - φ 3) > 0 ∧
  2 * (1 + φ 3) > |φ 0 - φ 2|

/-- A = 1 + φ_4 + φ_1 φ_5 - φ_5^2 (St(5) の補助量, 式(263)近辺) -/
def A5 (φ : Fin 5 → ℝ) : ℝ := 1 + φ 3 + φ 0 * φ 4 - φ 4 ^ 2

/-- B = φ_1 - φ_3 - φ_2 φ_5 + φ_4 φ_5 (St(5) の補助量) -/
def B5 (φ : Fin 5 → ℝ) : ℝ := φ 0 - φ 2 - φ 1 * φ 4 + φ 3 * φ 4

/-- St(5) の明示的閉形式 (6_kanren.tex, Section 4.5, 式(309)–(312)相当):
`φ(1)>0, φ(-1)>0, |φ_5|<1,`
`B^2+AB(φ_5-φ_1)+A^2(-1-φ_2+φ_4)<0, 2A>|B|` -/
def St5 (φ : Fin 5 → ℝ) : Prop :=
  phiAt1 φ > 0 ∧ phiAtNeg1 φ > 0 ∧ |φ 4| < 1 ∧
  (B5 φ) ^ 2 + (A5 φ) * (B5 φ) * (φ 4 - φ 0) + (A5 φ) ^ 2 * (-1 - φ 1 + φ 3) < 0 ∧
  2 * A5 φ > |B5 φ|

/-- A_6 = (1+φ_6)(φ_6^2-φ_2φ_6-φ_4-1) + (φ_5-φ_1)(φ_5+φ_1φ_6) (St(6) の補助量, 式(355)) -/
def A6 (φ : Fin 6 → ℝ) : ℝ :=
  (1 + φ 5) * (φ 5 ^ 2 - φ 1 * φ 5 - φ 3 - 1) + (φ 4 - φ 0) * (φ 4 + φ 0 * φ 5)

/-- B_6 = (φ_5+φ_1φ_6)(φ_6-φ_4+φ_2+1) - (1+φ_6)^2(φ_1-φ_3+φ_5) (St(6) の補助量, 式(358)) -/
def B6 (φ : Fin 6 → ℝ) : ℝ :=
  (φ 4 + φ 0 * φ 5) * (φ 5 - φ 3 + φ 1 + 1) - (1 + φ 5) ^ 2 * (φ 0 - φ 2 + φ 4)

/-- St(6) の明示的閉形式 (6_kanren.tex, Section 4.6, 式(388)–(389)相当):
`φ(1)>0, φ(-1)>0, 1-φ_6^2>|φ_5+φ_1φ_6|,`
`(1+φ_6)B_6^2+A_6B_6(φ_5-φ_1)+A_6^2(-1-φ_2+φ_4-φ_6)<0, -2A_6>|B_6|` -/
def St6 (φ : Fin 6 → ℝ) : Prop :=
  phiAt1 φ > 0 ∧ phiAtNeg1 φ > 0 ∧
  1 - φ 5 ^ 2 > |φ 4 + φ 0 * φ 5| ∧
  (1 + φ 5) * (B6 φ) ^ 2 + (A6 φ) * (B6 φ) * (φ 4 - φ 0) +
      (A6 φ) ^ 2 * (-1 - φ 1 + φ 3 - φ 5) < 0 ∧
  -2 * A6 φ > |B6 φ|

/-- 一般の AR(p) の定常性 (元の定義): 逆特性方程式
`ω^p = φ_1 ω^{p-1} + ⋯ + φ_p` の根がすべて単位円の内側にある。
`St4`/`St5`/`St6` がこの述語と同値であることを示すのが、
論文 Section 4.4–4.6 の証明そのものであり、ここでは述語の定義のみ用意する
(同値性の証明は今後の課題)。 -/
def IsStationary {p : ℕ} (φ : Fin p → ℝ) : Prop :=
  ∀ α : ℂ, α ^ p = ∑ i : Fin p, (φ i : ℂ) * α ^ (p - 1 - (i : ℕ)) → ‖α‖ < 1

end StTopology
